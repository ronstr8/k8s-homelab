  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nginx_ingress_controller_requests, host)",
          "refId": "var"
        },
        "definition": "label_values(nginx_ingress_controller_requests, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": []
