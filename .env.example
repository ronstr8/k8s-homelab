# Homelab cluster config — copy to .env and fill in.
# Make reads .env automatically; you can also: source .env && make ...
#
# Required
ACME_EMAIL = you@example.com

# Public domains served by this cluster's ingress (space-separated). Rewritten
# in CoreDNS to the ingress service so cert-manager's ACME HTTP-01 self-check
# resolves in-cluster instead of stalling on NAT hairpin. Leave empty to skip.
# (Let's Encrypt still validates externally via your port-80 forward.)
# ACME_SELFCHECK_DOMAINS = example.com app.example.com

# Cluster
CLUSTER_NAME     = homelab
REGISTRY_PORT    = 5000
STORAGE_PATH     = $(HOME)/.local/share/k8s-volumes

# Hostnames `make hosts` writes to /etc/hosts, pointed at the Kind node IP
# (space-separated). Set these to the domains your apps' ingresses serve.
# HOSTS = example.com app.example.com api.example.org

# Monitoring
MONITORING       = false
GRAFANA_PASSWORD = changeme
TEARDOWN_GRACE   = 60

# Persist cert-manager TLS certs + ACME account keys across recreates so a
# teardown doesn't force Let's Encrypt re-issuance (and prod rate limits).
# Certs (incl. private keys) are written to STORAGE_PATH/cert-backup on `make down`.
CERT_PERSIST     = false

# Pause / resume — `make pause` suspends the cluster for host maintenance
# (hardware swaps, reboots) without deleting it, so `make resume` restores every
# workload. Workloads drain ingress → apps → StatefulSets; list any Deployment
# that owns a database here to drain it on its own beat, just before the
# StatefulSets (space-separated "namespace/name").
# PAUSE_LAST      = moor/moor-daemon
PAUSE_GRACE     = 120

# Component versions — pin after first install so make recreate is reproducible
# Get current values: helm list -A -o json | jq -r '.[] | .name + " " + .chart'
CERT_MANAGER_VERSION     = v1.14.2
INGRESS_NGINX_VERSION    = controller-v1.11.3
# PROMETHEUS_CHART_VERSION = kube-prometheus-stack-XX.X.X

# GPU (requires nvidia-container-toolkit + Docker default-runtime=nvidia)
GPU_ENABLED = false
GPU_VENDOR  = nvidia

# Ollama — local LLM inference
OLLAMA           = false
OLLAMA_DATA_PATH = $(HOME)/.ollama
OLLAMA_MODEL     = gemma3:12b
# Server-wide serving ceiling. 32K fits gemma3:12b in ~12GB on a 16GB card;
# raise only if you have the VRAM to spare.
OLLAMA_CONTEXT_LENGTH = 32768
OLLAMA_GPU       = false
OLLAMA_GPU_COUNT = 1
OLLAMA_STORAGE   = 20Gi
OLLAMA_CPU_REQ   = 2
OLLAMA_CPU_LIM   = 4
OLLAMA_MEM_REQ   = 4Gi
OLLAMA_MEM_LIM   = 12Gi
# OLLAMA_INGRESS_HOST = ollama.example.com

# Hermes Agent — must be set at cluster creation time (make up / make recreate)
HERMES           = false
HERMES_DATA_PATH = $(HOME)/.hermes
# HERMES_DASHBOARD_INGRESS_HOST = hermes.example.com
# TLS issuer for the dashboard ingress (empty = no TLS). Options:
#   selfsigned-issuer | letsencrypt-staging | letsencrypt-prod
# letsencrypt-* require the host to be publicly reachable (real DNS + ports 80/443 forwarded).
# HERMES_DASHBOARD_CLUSTER_ISSUER = letsencrypt-prod
# Hermes api_server (port 8642) refuses to start without a key. Generate one with
#   openssl rand -hex 32
# and set it here (leave unset to keep api_server disabled in config.yaml).
# HERMES_API_SERVER_KEY =
