# Homelab cluster config — copy to .env and fill in.
# Make reads .env automatically; you can also: source .env && make ...
#
# Required
ACME_EMAIL = you@example.com

# Cluster
CLUSTER_NAME     = homelab
REGISTRY_PORT    = 5000
STORAGE_PATH     = $(HOME)/.local/share/k8s-volumes

# Monitoring
MONITORING       = false
GRAFANA_PASSWORD = changeme
TEARDOWN_GRACE   = 60

# Component versions — pin after first install so make recreate is reproducible
# Get current values: helm list -A -o json | jq -r '.[] | .name + " " + .chart'
CERT_MANAGER_VERSION     = v1.14.2
INGRESS_NGINX_VERSION    = controller-v1.11.3
# PROMETHEUS_CHART_VERSION = kube-prometheus-stack-XX.X.X

# GPU (requires nvidia-container-toolkit + Docker default-runtime=nvidia)
GPU_ENABLED = false
GPU_VENDOR  = nvidia

# Ollama — local LLM inference
OLLAMA           = false
OLLAMA_DATA_PATH = $(HOME)/.ollama
OLLAMA_MODEL     = llama3.2:3b
OLLAMA_GPU       = false
OLLAMA_GPU_COUNT = 1
OLLAMA_STORAGE   = 20Gi
OLLAMA_CPU_REQ   = 2
OLLAMA_CPU_LIM   = 4
OLLAMA_MEM_REQ   = 4Gi
OLLAMA_MEM_LIM   = 8Gi
# OLLAMA_INGRESS_HOST = ollama.yourdomain.com

# Hermes Agent — must be set at cluster creation time (make up / make recreate)
HERMES           = false
HERMES_DATA_PATH = $(HOME)/.hermes
# HERMES_DASHBOARD_INGRESS_HOST = hermes.yourdomain.com
